# /api 요청을 프록시할 백엔드 주소. 미설정 시 배포 백엔드를 사용한다.
BACKEND_ORIGIN=http://localhost:8080

# 기본은 비워두어 같은 출처의 /api 프록시와 로그인 쿠키를 사용한다.
# 직접 호출이 필요한 환경에서만 지정한다.
NEXT_PUBLIC_API_BASE_URL=

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
NEXT_PUBLIC_KAKAO_CLIENT_ID=

# 카카오 개발자 콘솔의 Redirect URI 등록값과 정확히 일치해야 한다.
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# 카카오맵 JavaScript SDK 키 (Kakao Developers > 배달이요 앱(무료 쿼터 보유) > 플랫폼 키 재사용 중)
NEXT_PUBLIC_KAKAO_MAP_KEY=
