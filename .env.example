# /api 요청을 프록시할 백엔드 주소. 미설정 시 배포 백엔드를 사용한다.
BACKEND_ORIGIN=http://localhost:8080

# 기본은 비워두어 같은 출처의 /api 프록시와 로그인 쿠키를 사용한다.
# 직접 호출이 필요한 환경에서만 지정한다.
NEXT_PUBLIC_API_BASE_URL=

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
NEXT_PUBLIC_KAKAO_CLIENT_ID=

# 카카오 개발자 콘솔의 Redirect URI 등록값과 정확히 일치해야 한다.
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# 지도 바탕 타일 URL(Leaflet). 비워 두면 CARTO voyager_nolabels(상호명 없는 지도)를 쓴다.
# CARTO 기본 타일은 개발용이다 — 운영에서는 키가 붙은 타일 URL 전체를 넣는다(실제 키는 커밋 금지).
# 관리자 앱과 같은 타일을 써야 부스 위치가 도로·건물 대비 똑같이 보인다. 바꾸면 다시 빌드해야 한다.
# 예: https://{s}.basemaps.cartocdn.com/rastertiles/voyager_nolabels/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAP_TILE_URL=

# 지도 오른쪽 아래 출처 표시(HTML). 비워 두면 OpenStreetMap·CARTO 출처를 쓴다. 타일 약관상 지우면 안 된다.
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
